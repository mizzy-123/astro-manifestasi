---
import BaseLayout from "../layouts/BaseLayout.astro"
import { Header } from "../components/common/Header.tsx"
import HeroSection from "../components/sections/HeroSection.astro"
import TrustedBySection from "../components/sections/TrustedBySection.astro"
import ProblemSection from "../components/sections/ProblemSection.astro"
import PortfolioSection from "../components/sections/PortfolioSection.astro"
import AuthoritySection from "../components/sections/AuthoritySection.astro"
import TestimoniSection from "../components/sections/TestimoniSection.astro"
import ProcessSection from "../components/sections/ProcessSection.astro"
import PricingSection from "../components/sections/PricingSection.astro"
import FitSection from "../components/sections/FitSection.astro"
import FaqSection from "../components/sections/FaqSection.astro"
import ContactSection from "../components/sections/ContactSection.astro"
import Footer from "../components/common/Footer"
---

<BaseLayout pageTitle="Website & Aplikasi Kustom untuk Otomatisasi Bisnis | Manifestasi">
	<Header client:load />
	<HeroSection />
	<TrustedBySection />
	<ProblemSection />
	<PortfolioSection />
	<AuthoritySection />
	<TestimoniSection />
	<ProcessSection />
	<PricingSection />
	<FitSection />
	<FaqSection />
	<ContactSection />
	<Footer client:load />
</BaseLayout>
