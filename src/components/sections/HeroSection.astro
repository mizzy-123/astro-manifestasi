---
import { HeroStatusCount } from "../common/HeroStatusCount";
import { WA_CONSULT } from "../../lib/whatsapp";
---

<section class="relative w-full overflow-hidden px-[4%] pb-16 pt-28" id="beranda">
  <div class="pointer-events-none absolute bottom-0 left-0">
    <svg xmlns="http://www.w3.org/2000/svg" width="210" height="562" viewBox="0 0 210 562" fill="none">
      <g filter="url(#filter0_f_hero_l)">
        <path d="M75 281C75 361.634 6.05186 427 -79 427C-164.052 427 -233 361.634 -233 281C-233 200.366 -164.052 135 -79 135C6.05186 135 75 200.366 75 281Z" fill="#643DE5" fill-opacity="0.4"/>
      </g>
      <defs>
        <filter id="filter0_f_hero_l" x="-367.6" y="0.399994" width="577.2" height="561.2" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
          <feFlood flood-opacity="0" result="BackgroundImageFix"/>
          <feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
          <feGaussianBlur stdDeviation="67.3" result="effect1_foregroundBlur_hero_l"/>
        </filter>
      </defs>
    </svg>
  </div>
  <div class="pointer-events-none absolute right-0 top-0">
    <svg xmlns="http://www.w3.org/2000/svg" width="188" height="546" viewBox="0 0 188 546" fill="none">
      <g filter="url(#filter0_f_hero_r)">
        <path d="M443 265C443 345.634 374.052 411 289 411C203.948 411 135 345.634 135 265C135 184.366 203.948 119 289 119C374.052 119 443 184.366 443 265Z" fill="#643DE5" fill-opacity="0.4"/>
      </g>
      <defs>
        <filter id="filter0_f_hero_r" x="0.399994" y="-15.6" width="577.2" height="561.2" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
          <feFlood flood-opacity="0" result="BackgroundImageFix"/>
          <feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
          <feGaussianBlur stdDeviation="67.3" result="effect1_foregroundBlur_hero_r"/>
        </filter>
      </defs>
    </svg>
  </div>

  <div id="hero-section" class="relative mx-auto grid w-full min-w-0 max-w-6xl items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
    <div class="flex min-w-0 flex-col items-start gap-6">
      <p class="rounded-full border border-color-main/40 bg-color-main/10 px-3 py-1 font-poppins text-xs text-color-main">
        Website & aplikasi untuk bisnis Anda
      </p>
      <h1 class="w-full font-plusjakartaregular text-[1.7rem] font-bold leading-tight text-balance text-font-white sm:text-[40px]">
        Otomatisasi Bisnis dan Tingkatkan Penjualan dengan <span class="text-color-main">Website & Aplikasi Kustom.</span>
      </h1>
      <p class="max-w-xl font-poppins text-base leading-relaxed text-font-white/90 sm:text-lg">
        Kami bantu membuat website dan aplikasi yang membuat kerja bisnis Anda lebih cepat, rapi, dan aman. Semuanya dibuat sesuai kebutuhan usaha Anda.
      </p>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a class="inline-flex h-[52px] items-center justify-center rounded-[10px] bg-gradient-to-r from-[#754DFB] to-[#452E95] px-6 font-poppins text-sm font-bold text-font-white" href={WA_CONSULT} target="_blank" rel="noopener noreferrer" data-cta="hero_mulai_projek">
          Mulai Projek
        </a>
        <a class="inline-flex h-[52px] items-center justify-center rounded-[10px] border border-white/20 px-6 font-poppins text-sm text-font-white" href="/#portofolio" data-cta="hero_lihat_portofolio">
          Lihat contoh hasil kerja
        </a>
      </div>
      <HeroStatusCount client:load />
    </div>

    <div class="relative mx-auto w-full min-w-0 max-w-[540px] pb-2">
      <div class="rounded-t-[18px] border border-white/10 bg-[#2a2a2e] p-2.5 shadow-[0_24px_80px_rgba(100,61,229,0.25)]">
        <div class="mb-2 flex items-center gap-1.5 px-1">
          <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
          <span class="ml-2 font-poppins text-[10px] text-white/40">laporan-bisnis</span>
        </div>
        <div class="overflow-hidden rounded-lg bg-[#12141c] p-4">
          <div class="mb-4 flex items-center justify-between">
            <p class="font-poppins text-sm font-bold text-white">Ringkasan penjualan</p>
            <span class="rounded-full bg-[#754DFB]/20 px-2 py-1 font-poppins text-[10px] text-[#c4b5fd]">Hari ini</span>
          </div>
          <div class="mb-4 grid grid-cols-3 gap-2">
            <div class="rounded-lg bg-white/5 p-2">
              <p class="font-poppins text-[10px] text-white/50">Omzet</p>
              <p class="font-poppins text-sm font-bold text-white">Rp 18,4jt</p>
            </div>
            <div class="rounded-lg bg-white/5 p-2">
              <p class="font-poppins text-[10px] text-white/50">Pesanan</p>
              <p class="font-poppins text-sm font-bold text-white">126</p>
            </div>
            <div class="rounded-lg bg-white/5 p-2">
              <p class="font-poppins text-[10px] text-white/50">Pembeli bayar</p>
              <p class="font-poppins text-sm font-bold text-[#c4b5fd]">+23%</p>
            </div>
          </div>
          <div class="mb-4 flex h-24 items-end gap-2 rounded-lg bg-white/5 px-3 py-2">
            <span class="h-[40%] w-full rounded-sm bg-[#754DFB]/40"></span>
            <span class="h-[62%] w-full rounded-sm bg-[#754DFB]/55"></span>
            <span class="h-[48%] w-full rounded-sm bg-[#754DFB]/45"></span>
            <span class="h-[78%] w-full rounded-sm bg-[#754DFB]/70"></span>
            <span class="h-[90%] w-full rounded-sm bg-gradient-to-t from-[#452E95] to-[#c4b5fd]"></span>
            <span class="h-[66%] w-full rounded-sm bg-[#754DFB]/60"></span>
            <span class="h-[84%] w-full rounded-sm bg-[#754DFB]/80"></span>
          </div>
          <div class="space-y-2">
            <div class="flex items-center justify-between rounded-md bg-white/5 px-3 py-2">
              <p class="font-poppins text-[11px] text-white">Pesanan #1042 · QRIS</p>
              <p class="font-poppins text-[11px] text-[#86efac]">Lunas</p>
            </div>
            <div class="flex items-center justify-between rounded-md bg-white/5 px-3 py-2">
              <p class="font-poppins text-[11px] text-white">Tagihan WA · Meja 7</p>
              <p class="font-poppins text-[11px] text-[#fde68a]">Terkirim</p>
            </div>
          </div>
        </div>
      </div>
      <div class="h-3 rounded-b-xl bg-[#3a3a3e]"></div>
      <div class="mx-auto h-2 w-28 rounded-b-md bg-[#4a4a4e]"></div>

      <div class="absolute bottom-8 right-1 w-[132px] rounded-[22px] border border-white/15 bg-[#1a1c24] p-2 shadow-2xl sm:right-0 sm:w-[148px]">
        <div class="rounded-[16px] bg-[#0e1016] p-3">
          <div class="mx-auto mb-3 h-1 w-10 rounded-full bg-white/20"></div>
          <p class="mb-2 font-poppins text-[10px] font-bold text-white">Bayar QRIS</p>
          <div class="mb-2 grid grid-cols-4 gap-1 rounded-md bg-white p-2">
            <span class="col-span-2 row-span-2 h-6 rounded-sm bg-[#12141c]"></span>
            <span class="h-2.5 rounded-sm bg-[#12141c]"></span>
            <span class="h-2.5 rounded-sm bg-[#12141c]/30"></span>
            <span class="h-2.5 rounded-sm bg-[#12141c]/40"></span>
            <span class="h-2.5 rounded-sm bg-[#12141c]"></span>
            <span class="h-2 rounded-sm bg-[#12141c]/50"></span>
            <span class="h-2 rounded-sm bg-[#12141c]"></span>
            <span class="h-2 rounded-sm bg-[#12141c]/30"></span>
            <span class="h-2 rounded-sm bg-[#12141c]/70"></span>
          </div>
          <p class="text-center font-poppins text-[10px] text-white/70">Rp 86.000</p>
          <div class="mt-2 rounded-md bg-gradient-to-r from-[#754DFB] to-[#452E95] py-1 text-center font-poppins text-[10px] font-bold text-white">
            Konfirmasi
          </div>
        </div>
      </div>
      <p class="mt-4 max-w-[68%] font-poppins text-xs text-white/50">Contoh tampilan laporan penjualan dan pembayaran</p>
    </div>
  </div>
</section>
