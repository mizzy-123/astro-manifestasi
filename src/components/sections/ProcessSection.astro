---

const steps = [
  {
    n: "01",
    title: "Analisis kebutuhan & functional specification",
    text: "Kami petakan alur kerja, peran pengguna, dan batas fitur. Hasilnya dokumen spesifikasi yang disepakati sebelum desain dan kode dimulai.",
  },
  {
    n: "02",
    title: "Desain UI/UX & prototyping",
    text: "Alur layar disusun dulu sebagai prototipe, supaya Anda bisa mencoba jalannya sistem sebelum development berjalan penuh.",
  },
  {
    n: "03",
    title: "Frontend, backend, dan API",
    text: "Antarmuka dan API dibangun bersamaan. Akses data dibatasi sesuai peran, bukan dibiarkan terbuka ke siapa saja yang punya tautan.",
  },
  {
    n: "04",
    title: "Quality assurance",
    text: "Alur utama diuji: buat data, ubah status, bayar, dan kondisi gagal. Bug yang menghalangi operasional dibereskan sebelum naik ke server.",
  },
  {
    n: "05",
    title: "Deployment & serah terima source code",
    text: "Sistem dipasang di server, lalu repositori source code diserahkan. Anda memegang kodenya, bukan hanya tampilan yang jalan di hosting kami.",
  },
];
---

<section class="w-full px-[4%] py-20" id="layanan">
  <div class="mx-auto w-full max-w-6xl">
    <div class="mb-10 max-w-2xl">
      <p class="mb-2 font-poppins text-sm text-color-main">Yang Anda dapatkan</p>
      <h2 class="font-plusjakartaregular text-2xl font-bold text-font-white sm:text-[32px]">
        Proses kerja yang bisa Anda ikuti dari awal
      </h2>
      <p class="mt-3 font-poppins text-sm text-white/70 sm:text-base">
        Anda tidak membeli janji di chat. Setiap tahap punya keluaran yang bisa dicek.
      </p>
    </div>
    <ol class="grid gap-4 md:grid-cols-2">
      {steps.map((step) => (
        <li class="flex gap-4 rounded-2xl border border-white/10 bg-white/5 p-5">
          <span class="font-plusjakartaregular text-2xl font-bold text-color-main">{step.n}</span>
          <div>
            <h3 class="font-poppins text-base font-bold text-font-white">{step.title}</h3>
            <p class="mt-1 font-poppins text-sm leading-relaxed text-white/70">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
