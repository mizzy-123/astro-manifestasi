---

const steps = [
  {
    n: "01",
    title: "Diskusi kebutuhan",
    text: "Kami tanya cara kerja bisnis Anda sekarang, lalu menulis daftar fitur yang akan dibuat. Daftar ini Anda setujui dulu sebelum pengerjaan dimulai.",
  },
  {
    n: "02",
    title: "Rancangan tampilan",
    text: "Kami buat contoh tampilannya dulu. Anda bisa lihat dan mencoba alurnya sebelum aplikasi benar-benar dibuat.",
  },
  {
    n: "03",
    title: "Pembuatan website atau aplikasi",
    text: "Kami buat tampilan dan sistem di belakangnya. Data dijaga supaya hanya orang yang berhak yang bisa membukanya.",
  },
  {
    n: "04",
    title: "Pengujian",
    text: "Kami coba semua alur penting, misalnya pesan, bayar, dan cek status, termasuk saat ada yang gagal. Masalah diperbaiki sebelum dipakai.",
  },
  {
    n: "05",
    title: "Online dan serah terima",
    text: "Website atau aplikasi dipasang di server supaya bisa dipakai. Kami juga serahkan file kode programnya, jadi hasilnya benar-benar milik Anda.",
  },
];
---

<section class="w-full px-[4%] py-20" id="layanan">
  <div class="mx-auto w-full max-w-6xl">
    <div class="mb-10 max-w-2xl">
      <p class="mb-2 font-poppins text-sm text-color-main">Cara kerja kami</p>
      <h2 class="font-plusjakartaregular text-2xl font-bold text-font-white sm:text-[32px]">
        Prosesnya jelas, Anda bisa ikut memantau
      </h2>
      <p class="mt-3 font-poppins text-sm text-white/70 sm:text-base">
        Anda tahu apa yang sedang dikerjakan di setiap tahap, dan apa hasilnya.
      </p>
    </div>
    <ol class="grid gap-4 md:grid-cols-2">
      {steps.map((step) => (
        <li class="flex gap-4 rounded-2xl border border-white/10 bg-white/5 p-5">
          <span class="font-plusjakartaregular text-2xl font-bold text-color-main">{step.n}</span>
          <div>
            <h3 class="font-poppins text-base font-bold text-font-white">{step.title}</h3>
            <p class="mt-1 font-poppins text-sm leading-relaxed text-white/70">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
