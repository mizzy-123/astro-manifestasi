---
import TestimoniCard from "../common/TestimoniCard";




---

<section class="flex w-full flex-col items-center gap-8 px-[4%] py-20" id="testimoni">
    <div class="mx-auto flex w-full max-w-6xl flex-col items-center gap-3 text-center">
      <p class="font-poppins text-sm text-color-main">Kata klien kami</p>
      <h2 class="font-plusjakartaregular text-2xl font-bold text-font-white sm:text-[32px]">Pesan dari klien setelah proyek selesai</h2>
      <p class="max-w-2xl font-poppins text-sm text-white/70">Ini kutipan asli dari chat klien. Kami tidak mengubah isinya.</p>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <span class="rounded-full border border-white/15 px-4 py-2 font-poppins text-sm text-white/80">Albitec</span>
      <span class="rounded-full border border-white/15 px-4 py-2 font-poppins text-sm text-white/80">Foodyar</span>
      <span class="rounded-full border border-white/15 px-4 py-2 font-poppins text-sm text-white/80">Griya Bugar</span>
    </div>
    <TestimoniCard client:load />
</section>