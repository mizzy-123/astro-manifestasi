---
import "../styles/global.css";
const { pageTitle } = Astro.props;
---

<html class="dark" lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="title" content="Manifestasi | Website dan aplikasi kustom untuk otomatisasi bisnis">
		<meta name="description" content="Bangun sistem digital yang cepat, aman, dan dirancang untuk skala bisnis Anda. Company profile, web app, e-commerce, hingga aplikasi Android native.">
		<meta name="keywords" content="jasa website, jasa aplikasi, web app, e-commerce, aplikasi android, company profile, landing page, sistem kasir, otomatisasi bisnis" />

		<!-- IG/Fecebook dll -->
		<meta property="og:title" content="Manifestasi - Otomatisasi Bisnis dengan Website dan Aplikasi Kustom" />
		<meta property="og:description" content="Bangun sistem digital yang cepat, aman, dan dirancang khusus untuk skala bisnis Anda." />
		<meta property="og:image" content="https://manifestasi.my.id/asset/image/logo.png" />
		<meta property="og:url" content="https://manifestasi.my.id" />
		<meta property="og:type" content="website" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:url" content="https://manifestasi.my.id/">
		<meta name="twitter:title" content="Website dan Aplikasi Kustom untuk Otomatisasi Bisnis | Manifestasi">
		<meta name="twitter:description" content="Bangun sistem digital yang cepat, aman, dan dirancang khusus untuk skala bisnis Anda.">
		<meta name="twitter:image" content="https://manifestasi.my.id/asset/image/logo.png">

		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6TF2ESZLRE"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-6TF2ESZLRE');
		</script>

		<script is:inline type="application/ld+json">
			{
			  "@context": "https://schema.org",
			  "@type": "Organization",
			  "name": "Manifestasi",
			  "url": "https://manifestasi.my.id",
			  "logo": "https://manifestasi.my.id/asset/image/logo.png",
			  "description": "Manifest adalah tim developer berpengalaman yang selama lima tahun terakhir telah mendedikasikan diri untuk mewujudkan visi bisnis Anda dalam bentuk solusi digital yang tangguh dan terjangkau. Kami memahami betul bahwa di era yang serba digital ini, memiliki kehadiran online yang kuat melalui website, aplikasi, serta desain yang profesional bukan lagi pilihan, melainkan keharusan untuk survive dan berkembang. Itulah mengapa kami berkomitmen untuk menjadi mitra terpercaya Anda, bekerja sama membangun setiap detail proyek digital, memastikan Anda mendapatkan layanan terbaik yang bukan hanya inovatif dan berkelas, tetapi juga selaras dengan anggaran Anda.",
			  "sameAs": [
				"https://www.instagram.com/manifestasi_tech"
			  ]
			}
		  
		</script>
		<script is:inline type="application/ld+json">
			{
			  "@context": "https://schema.org",
			  "@type": "BreadcrumbList",
			  "itemListElement": [
				{
				  "@type": "ListItem",
				  "position": 1,
				  "name": "Beranda",
				  "item": "https://www.manifestasi.my.id/#beranda"
				},
				{
				  "@type": "ListItem",
				  "position": 2,
				  "name": "Tentang Kami",
				  "item": "https://www.manifestasi.my.id/tentang-kami"
				},
				{
				  "@type": "ListItem",
				  "position": 3,
				  "name": "Layanan",
				  "item": "https://www.manifestasi.my.id/#layanan"
				},
				{
				  "@type": "ListItem",
				  "position": 4,
				  "name": "Portfolio",
				  "item": "https://www.manifestasi.my.id/#portfolio"
				},
				{
				  "@type": "ListItem",
				  "position": 5,
				  "name": "FaQ",
				  "item": "https://www.manifestasi.my.id/#faq"
				},
				{
				  "@type": "ListItem",
				  "position": 6,
				  "name": "Testimoni",
				  "item": "https://www.manifestasi.my.id/#testimoni"
				},
				{
				  "@type": "ListItem",
				  "position": 7,
				  "name": "Hubungi Kami",
				  "item": "https://www.manifestasi.my.id/#kontak"
				}
			  ]
			}
		</script>
		<title>{pageTitle}</title>
	</head>
	<body class="dark:bg-background2">
		<main>
			<slot />
		</main>

	</body>
</html>
